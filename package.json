{
  "name": "windforge",
  "private": true,
  "type": "module",
  "description": "Windforge — open-source styling engine for React Native. Tailwind-first frontend, platform-independent Style IR, backends for RN native and React Native Web.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "bench": "turbo run bench",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
