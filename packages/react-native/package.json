{
  "name": "@windforge/react-native",
  "version": "0.0.1",
  "description": "Windforge runtime for React Native — artifact registry, className resolution, styled components",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@windforge/ir": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.86"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
