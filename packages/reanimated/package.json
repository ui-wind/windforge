{
  "name": "@windforge/reanimated",
  "version": "0.0.1",
  "description": "Windforge Reanimated adapter — class-driven keyframes and transitions on the UI thread",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@windforge/ir": "workspace:*",
    "@windforge/react-native": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.83 <0.87",
    "react-native-reanimated": "^4.5",
    "react-native-worklets": "^0.10"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
